# Copie este arquivo para `.env` e ajuste os valores.
# NUNCA faça commit do `.env` (ele já está no .gitignore).

# --- Django ---
# Gere uma chave nova para produção, ex.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
# Valores APENAS para desenvolvimento local. Em produção, use senhas fortes e únicas.
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk
# Para rodar o backend direto no Windows/Linux (PostgreSQL instalado localmente).
# No Docker, o docker-compose.yml sobrescreve esta variável trocando "localhost" por "db".
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk
